# Copy this file to ".env" and fill in your own values. Never commit ".env".
NODE_ENV=development
PORT=3000

# Public base URL used when building share links (no trailing slash)
BASE_URL=http://localhost:3000

# MySQL (the database is created by database.sql)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=dear_in_stereo_db

# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_me_with_a_long_random_string

# Set to 1 when running behind a reverse proxy / HTTPS terminator (production)
TRUST_PROXY=0
